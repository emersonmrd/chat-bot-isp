# ==========================================
# CONFIGURAÇÕES GERAIS E BANCO DE DADOS
# ==========================================
POSTGRES_USER=isp_user
POSTGRES_PASSWORD=isp_super_secret_pass
POSTGRES_DB=isp_chatbot_db

# ==========================================
# EVOLUTION API
# ==========================================
# URL base para acesso à Evolution API local
EVOLUTION_SERVER_URL=http://localhost:8080
# Chave mestra de autenticação (crie uma senha forte)
EVOLUTION_API_KEY=evolucao_isp_key_2026

# ==========================================
# n8n
# ==========================================
# URL que o n8n vai expor (importante para webhooks)
N8N_WEBHOOK_URL=http://localhost:5678
# Chave de encriptação dos dados sensíveis no n8n (gerar string aleatória)
N8N_ENCRYPTION_KEY=n8n_super_secret_key_12345

# ==========================================
# CHATWOOT
# ==========================================
# URL de acesso ao Chatwoot local
CHATWOOT_FRONTEND_URL=http://localhost:3000
# Chave secreta do Chatwoot (gerar string aleatória longa)
CHATWOOT_SECRET_KEY=chatwoot_super_secret_base_key_9876543210
