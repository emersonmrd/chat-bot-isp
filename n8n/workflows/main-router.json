              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.remoteJid.replace('@s.whatsapp.net', '') }}\",\n  \"text\": \"🔧 *Suporte Técnico*\\n\\nVamos verificar sua conexão! Por favor, observe as luzes do seu modem/roteador:\\n\\nA luz com o nome *LOS* (ou PON) está *vermelha* ou *piscando*?\\n\\nResponda com:\\n*SIM* ou *NAO*\"\n}"
      },
